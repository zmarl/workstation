{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r /*)",
      "Bash(rmdir /s /q *)",
      "Bash(del /s /q *)",
      "Bash(rd /s /q *)",
      "Bash(format *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin +*)",
      "Bash(git.exe push --force*)",
      "Bash(git.exe push -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git branch -D *)",
      "Bash(git clean -f*)",
      "Bash(gh release create*)",
      "Bash(gh.exe release create*)",
      "Bash(npm publish*)",
      "Bash(npm.cmd publish*)",
      "Bash(uv publish*)",
      "Bash(uv.exe publish*)",
      "Bash(yarn publish*)",
      "Bash(pnpm publish*)",
      "Bash(pnpm.cmd publish*)",
      "Bash(cargo publish*)",
      "Bash(cargo.exe publish*)",
      "Bash(cargo +stable publish*)",
      "Bash(cargo +beta publish*)",
      "Bash(cargo +nightly publish*)",
      "Bash(twine upload*)",
      "Bash(docker push*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(powershell * -EncodedCommand *)",
      "Bash(pwsh * -EncodedCommand *)",
      "Bash(pwsh.exe * -EncodedCommand *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(sudo rm *)",
      "Bash(sudo chmod *)",
      "Bash(> /dev/sd*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(mkfs.*)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.staging)",
      "Read(.env.development)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*_rsa)",
      "Read(**/*_dsa)",
      "Read(**/*_ecdsa)",
      "Read(**/*_ed25519)",
      "Read(**/id_rsa*)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/auth.json)",
      "Read(**/tokens/*.json)",
      "Read(**/.token*)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(.env.staging)",
      "Edit(.env.development)",
      "Edit(secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/credentials.json)",
      "Edit(**/auth.json)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "fable[1m]",
  "hooks": {},
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "planning-with-files@planning-with-files": false,
    "claude-mem@thedotmack": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true
}
